# API Base URL (seu backend que expõe /api/nav e /api/reserve)
EXPO_PUBLIC_API_BASE_URL=

# Solana Devnet — IDs dos programas deployados
# Obtenha com: solana address -k oracle-program.json (etc)
EXPO_PUBLIC_ORACLE_PROGRAM_ID=
EXPO_PUBLIC_TOKEN_PROGRAM_ID=
EXPO_PUBLIC_RESERVE_PROGRAM_ID=
EXPO_PUBLIC_GOVERNANCE_PROGRAM_ID=

# RPC Solana Devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Base Sepolia — Oracle address (se houver)
EXPO_PUBLIC_ORACLE_ADDRESS=
EXPO_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org